# Passwort für den Login. Pflichtfeld — ohne dieses startet die App nicht.
APP_PASSWORD=bitte-aendern

# Secret zum Signieren des Session-Cookies. Mindestens 32 Zeichen.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=bitte-durch-zufallswert-ersetzen-mindestens-32-zeichen

# Optional: Sitzungsdauer in Stunden (Standard 12)
SESSION_HOURS=12

# Optional: maximale Uploadgrösse pro Datei in MB (Standard 100)
MAX_UPLOAD_MB=100

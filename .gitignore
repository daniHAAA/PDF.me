# Abhängigkeiten
/node_modules/
/.pnp
.pnp.*

# Next.js
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# Umgebung — enthält Passwort und Session-Secret, gehört nie ins Repository
.env
.env*.local

# Laufzeit-Assets von pdf.js und tesseract.js.
